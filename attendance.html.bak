<script src="js/ean13.js"></script>
<script src="js/barcodeScanner.js?v=1"></script>
<script src="js/registrationService.js?v=4"></script>
<script src="js/subjectService.js?v=4"></script>
<script src="js/attendanceService.js?v=4"></script>
<script src="js/subscriptionService.js?v=1"></script><style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --primary:#6366f1;--primary-dark:#4f46e5;--primary-soft:rgba(99,102,241,0.10);
  --gold:#c8a84b;--gold-dark:#8a6d1f;--gold-light:rgba(200,168,75,0.14);
  --navy:#141a4d;--ink:#221e52;--muted:#5b6483;--soft:#9aa3c4;
  --card:#ffffff;--glass-dark:rgba(18,22,54,0.55);
  --border:#e4e7f2;--border-light:#eef0f7;
  --green:#059669;--green-light:rgba(5,150,105,0.12);
  --red:#dc2626;--red-light:rgba(220,38,38,0.12);
  --amber:#b45309;--amber-light:rgba(180,83,9,0.12);
  --radius:20px;--radius-sm:13px;
  --shadow-lg:0 22px 55px rgba(15,20,60,0.22);
  --shadow-sm:0 8px 22px rgba(15,20,60,0.12);
}
html,body{height:100%}
body{font-family:'Tajawal',system-ui,sans-serif;background:linear-gradient(150deg,#151a46 0%,#2a2f77 48%,#3f3aa0 100%);color:var(--ink);line-height:1.6;overflow:hidden;-webkit-font-smoothing:antialiased}
.bg-video{position:fixed;inset:0;z-index:0;overflow:hidden;background:#101538}
.bg-video video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.01)}
.bg-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,18,52,0.55) 0%,rgba(14,18,52,0.42) 45%,rgba(12,15,44,0.82) 100%)}
.bg-glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(62% 48% at 50% 0%,rgba(200,168,75,0.18),transparent 70%),radial-gradient(45% 40% at 85% 100%,rgba(99,102,241,0.20),transparent 70%)}
.view{display:none}.view.active{display:flex}
#view-pin{position:fixed;inset:0;z-index:60;align-items:center;justify-content:center;padding:22px;animation:fadeIn .4s ease both}
.pin-card{width:100%;max-width:400px;border-radius:26px;padding:40px 34px 34px;text-align:center;background:rgba(20,24,58,0.62);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border:1px solid rgba(255,255,255,0.16);box-shadow:0 30px 70px rgba(8,10,34,0.5);animation:cardPop .45s ease both}
.pin-logo{width:180px;margin:0 auto 18px;line-height:0;filter:drop-shadow(0 16px 34px rgba(200,168,75,0.28));animation:logoIn .7s ease both}
.pin-logo img{width:100%;height:auto;object-fit:contain;display:block}
.pin-brand-en{font-size:15px;font-weight:900;letter-spacing:2px;color:#fff}
.pin-brand-ar{font-size:12px;color:#c7d2fe;font-weight:700;margin-bottom:22px}
.pin-lock{font-size:30px;margin-bottom:10px}
.pin-title{font-size:19px;font-weight:900;color:#fff;margin-bottom:4px}
.pin-sub{font-size:13px;color:#c7d2fe;font-weight:600;margin-bottom:24px}
.pin-input{width:100%;font-family:'Tajawal',sans-serif;font-size:22px;font-weight:900;letter-spacing:10px;text-align:center;direction:ltr;padding:13px 14px;border-radius:14px;outline:none;border:1.5px solid rgba(255,255,255,0.25);background:rgba(255,255,255,0.08);color:#fff;caret-color:#c8a84b;transition:.2s}
.pin-input:focus{border-color:#c8a84b;background:rgba(255,255,255,0.12);box-shadow:0 0 0 4px rgba(200,168,75,0.18)}
.pin-btn{width:100%;margin-top:16px;font-family:'Tajawal',sans-serif;font-size:16px;font-weight:900;color:#fff;background:linear-gradient(135deg,#6366f1,#4338ca);border:none;border-radius:14px;padding:14px;cursor:pointer;transition:.2s;box-shadow:0 10px 24px rgba(99,102,241,0.4)}
.pin-btn:hover{filter:brightness(1.1);transform:translateY(-1px)}
.pin-btn:active{transform:translateY(0)}
.pin-error{min-height:20px;margin-top:14px;font-size:13px;font-weight:800;color:#fca5a5;opacity:0;transform:translateY(-4px);transition:.25s;visibility:hidden}
.pin-error.show{opacity:1;transform:translateY(0);visibility:visible;animation:shake .4s ease}
.pin-foot{margin-top:26px;font-size:11px;color:#94a3b8;font-weight:600}
#app{position:fixed;inset:0;z-index:2;display:flex;flex-direction:column}
#app.locked{display:none}
header.topbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 20px;background:rgba(15,19,48,0.5);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.12)}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.brand .logo{height:42px;width:auto;max-width:160px;object-fit:contain;flex-shrink:0;border-radius:8px;filter:drop-shadow(0 4px 14px rgba(0,0,0,0.35));background:rgba(255,255,255,0.94);padding:4px 8px}
.brand .title{color:#fff;min-width:0}
.brand .title .en{font-size:14px;font-weight:900;letter-spacing:1px;white-space:nowrap}
.brand .title .ar{font-size:11px;color:#c7d2fe;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.live-badge{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:800;color:#86efac;background:rgba(5,150,105,0.16);border:1px solid rgba(5,150,105,0.4);border-radius:99px;padding:2px 8px;margin-inline-start:6px}
.live-badge .dot{width:6px;height:6px;border-radius:50%;background:#22c55e;animation:blink 1.4s infinite}

.top-actions{display:flex;align-items:center;gap:10px}
.clock{text-align:left;color:#fff}
.clock .time{font-size:20px;font-weight:900;font-variant-numeric:tabular-nums;letter-spacing:1px;line-height:1.1}
.clock .date{font-size:11px;color:#c7d2fe}
.lock-btn{font-family:'Tajawal',sans-serif;font-size:11px;font-weight:800;color:#fecaca;background:rgba(220,38,38,0.16);border:1px solid rgba(220,38,38,0.4);border-radius:99px;padding:6px 14px;cursor:pointer;transition:.2s;display:inline-flex;align-items:center;gap:5px}
.lock-btn:hover{background:rgba(220,38,38,0.28);color:#fff}
main{flex:1;position:relative;overflow:hidden}
.view-screen{position:absolute;inset:0;flex-direction:column;align-items:center;justify-content:center;padding:16px;overflow-y:auto}
.view-screen.active{animation:fadeIn .35s ease both}

.kiosk-layout{display:flex;gap:14px;width:100%;max-width:1060px;height:100%;align-items:center;justify-content:center;padding:8px}
.kiosk-sidebar{width:200px;flex-shrink:0;display:flex;flex-direction:column;gap:12px}
.k-counter{background:rgba(20,24,58,0.55);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.14);border-radius:16px;padding:16px 14px;text-align:center}
.k-counter-label{font-size:10px;font-weight:800;color:#c7d2fe;margin-bottom:2px}
.k-counter-num{font-size:40px;font-weight:900;color:#fff;line-height:1;font-variant-numeric:tabular-nums}
.k-counter-num .sep{font-size:26px;color:#c7d2fe;margin:0 2px}
.kiosk-main{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;min-width:0}
.scan-stage{position:relative;width:210px;height:210px;margin:0 auto 14px}
.scan-stage .ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,0.18)}
.scan-stage .ring.r1{animation:ringPulse 2.6s infinite}
.scan-stage .ring.r2{animation:ringPulse 2.6s .85s infinite}
.scan-stage .ring.r3{animation:ringPulse 2.6s 1.7s infinite}
.scan-card{position:absolute;inset:28px;border-radius:20px;overflow:hidden;background:linear-gradient(150deg,#ffffff,#eef0ff);box-shadow:0 22px 55px rgba(0,0,0,0.4);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;border:2px solid rgba(200,168,75,0.55);transition:border-color .3s,box-shadow .3s}
.scan-card .bars{display:flex;align-items:flex-end;gap:3px;height:44px}
.scan-card .bars i{background:#221e52;border-radius:2px;display:block}
.scan-card .code-num{font-family:monospace;font-size:10px;color:#4338ca;letter-spacing:2px;font-weight:700;direction:ltr}
.scan-card .chip{font-size:8px;font-weight:900;color:#fff;background:#6366f1;border-radius:6px;padding:2px 8px;letter-spacing:1px}
.scan-card .scanline{position:absolute;left:8px;right:8px;height:2px;border-radius:2px;top:10%;background:linear-gradient(90deg,transparent,#4ade80,transparent);box-shadow:0 0 12px rgba(74,222,128,0.85);opacity:0;animation:scanSweep 2.4s ease-in-out infinite}
.k-ready-text{color:#fff;font-size:17px;font-weight:900;margin-bottom:3px;text-align:center}
.k-ready-sub{color:#c7d2fe;font-size:12px;font-weight:600;margin-bottom:12px;text-align:center}
.k-status-pill{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:800;color:#fff;background:rgba(255,255,255,0.10);border:1px solid rgba(255,255,255,0.20);border-radius:99px;padding:7px 16px}
.k-status-pill .dot{width:7px;height:7px;border-radius:50%;background:#22c55e;animation:blink 1.4s infinite}
.k-last-read{font-family:monospace;font-size:11px;color:#a5b4fc;margin-top:8px;min-height:16px;letter-spacing:2px;direction:ltr}
.manual-toggle{color:#a5b4fc;font-size:11px;font-weight:700;cursor:pointer;border:none;background:none;font-family:inherit;margin-top:6px;text-decoration:underline}
.manual-row{display:none;margin-top:8px;gap:7px;align-items:center;justify-content:center}
.manual-row.show{display:flex}
.manual-row input{font-family:monospace;font-size:13px;padding:7px 10px;border-radius:9px;border:2px solid rgba(255,255,255,0.25);background:rgba(255,255,255,0.08);color:#fff;width:180px;text-align:center;direction:ltr;outline:none}
.manual-row input:focus{border-color:var(--primary)}
.manual-row button{font-family:inherit;font-size:11px;font-weight:800;color:#fff;background:var(--primary);border:none;border-radius:9px;padding:7px 14px;cursor:pointer}
.manual-row button:hover{background:var(--primary-dark)}
.debug-toggle{font-family:inherit;font-size:10px;font-weight:800;color:#c7d2fe;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.16);border-radius:99px;padding:4px 10px;cursor:pointer;margin-top:6px;transition:.2s}
.debug-toggle:hover{background:rgba(255,255,255,0.14);color:#fff}
.debug-panel{display:none;margin-top:8px;background:rgba(2,6,23,0.9);border:1px solid #334155;border-radius:11px;padding:10px;text-align:right;direction:rtl;max-width:480px;width:100%}
.debug-panel.show{display:block;animation:fadeIn .25s ease both}
.debug-panel h4{color:#e2e8f0;font-size:11px;font-weight:900;margin-bottom:6px;font-family:monospace}
.debug-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px 10px;font-family:monospace;font-size:10px;color:#cbd5e1}
.debug-grid .d{display:flex;justify-content:space-between;gap:6px;border-bottom:1px dashed #1e293b;padding:2px 0}
.debug-grid .d .k{color:#64748b;white-space:nowrap}
.debug-grid .d .v{color:#7dd3fc;word-break:break-all;direction:ltr;text-align:left;max-width:62%}
.debug-grid .d .v.good{color:#4ade80}
.debug-log{background:#0f172a;border-radius:7px;padding:5px;margin-top:6px;max-height:90px;overflow-y:auto;font-family:monospace;font-size:9px;color:#67e8f9;text-align:left;direction:ltr;line-height:1.7}
.scan-overlay{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;animation:fadeIn .25s ease both}
.scan-overlay.green{background:rgba(5,150,105,0.88);backdrop-filter:blur(6px)}
.scan-overlay.orange{background:rgba(180,83,9,0.88);backdrop-filter:blur(6px)}
.scan-overlay.red{background:rgba(220,38,38,0.88);backdrop-filter:blur(6px)}
.scan-overlay.show{display:flex}
.scan-overlay .so-inner{text-align:center;color:#fff;animation:cardPop .3s ease both}
.scan-overlay .so-icon{font-size:64px;margin-bottom:12px}
.scan-overlay .so-title{font-size:26px;font-weight:900;margin-bottom:6px}
.scan-overlay .so-name{font-size:18px;font-weight:700;opacity:.9;margin-bottom:4px}
.scan-overlay .so-sub{font-size:13px;font-weight:600;opacity:.75;line-height:1.7}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes cardPop{0%{opacity:0;transform:scale(.9)}70%{transform:scale(1.03)}100%{opacity:1;transform:scale(1)}}
@keyframes ringPulse{0%{transform:scale(.85);opacity:.8}100%{transform:scale(1.28);opacity:0}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.35}}
@keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}
@keyframes scanSweep{0%{top:8%;opacity:0}14%{opacity:1}86%{opacity:1}100%{top:86%;opacity:0}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@keyframes logoIn{from{opacity:0;transform:translateY(10px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}
@media(max-width:768px){.clock .date{display:none}}
@media(max-width:640px){.kiosk-layout{flex-direction:column;gap:8px}.kiosk-sidebar{width:100%;flex-direction:row;gap:6px}.k-counter{flex:1;padding:10px 8px}.k-counter-num{font-size:26px}.clock .time{font-size:16px}}
.view-teachers{display:none;position:fixed;inset:0;z-index:50;background:rgba(14,18,52,0.92);backdrop-filter:blur(12px);flex-direction:column;padding:20px;overflow-y:auto}
.view-teachers.active{display:flex;animation:fadeIn .3s ease both}
.ts-header{text-align:center;margin-bottom:20px;flex-shrink:0}
.ts-student-name{font-size:28px;font-weight:900;color:#fff;margin-bottom:4px}
.ts-student-id{font-size:13px;color:#c7d2fe;font-weight:600}
.ts-subtitle{font-size:15px;color:#c7d2fe;font-weight:700;margin-top:10px}
.ts-back{position:absolute;top:16px;left:16px;font-family:'Tajawal',sans-serif;font-size:12px;font-weight:800;color:#fecaca;background:rgba(220,38,38,0.16);border:1px solid rgba(220,38,38,0.3);border-radius:99px;padding:6px 16px;cursor:pointer;transition:.2s;z-index:5}
.ts-back:hover{background:rgba(220,38,38,0.3);color:#fff}
.ts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;width:100%;max-width:1100px;margin:0 auto;flex:1;align-content:start}
.ts-card{border-radius:20px;padding:28px 20px;text-align:center;cursor:pointer;transition:transform .2s,box-shadow .2s;border:2px solid rgba(255,255,255,0.12);animation:cardPop .35s ease both}
.ts-card:active{transform:scale(.96)}
.ts-card .tc-icon{width:56px;height:56px;border-radius:50%;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:26px}
.ts-card .tc-name{font-size:18px;font-weight:900;color:#fff;margin-bottom:4px}
.ts-card .tc-subject{font-size:13px;font-weight:700;opacity:.8}
.ts-card.t1{background:rgba(99,102,241,0.25)}.ts-card.t1 .tc-icon{background:rgba(99,102,241,0.3)}
.ts-card.t2{background:rgba(16,185,129,0.25)}.ts-card.t2 .tc-icon{background:rgba(16,185,129,0.3)}
.ts-card.t3{background:rgba(245,158,11,0.25)}.ts-card.t3 .tc-icon{background:rgba(245,158,11,0.3)}
.ts-card.t4{background:rgba(239,68,68,0.25)}.ts-card.t4 .tc-icon{background:rgba(239,68,68,0.3)}
.ts-card.t5{background:rgba(168,85,247,0.25)}.ts-card.t5 .tc-icon{background:rgba(168,85,247,0.3)}
.ts-card.t6{background:rgba(14,165,233,0.25)}.ts-card.t6 .tc-icon{background:rgba(14,165,233,0.3)}
.ts-card.t7{background:rgba(236,72,153,0.25)}.ts-card.t7 .tc-icon{background:rgba(236,72,153,0.3)}
.ts-card.t8{background:rgba(34,197,94,0.25)}.ts-card.t8 .tc-icon{background:rgba(34,197,94,0.3)}
@media(max-width:640px){.ts-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}.ts-card{padding:20px 14px}.ts-card .tc-name{font-size:15px}}
</style>
</head>
<body>
<div class="bg-video" aria-hidden="true">
  <video id="bg-video" autoplay muted loop playsinline preload="auto">
    <source src="videos/attendencebackground.mp4" type="video/mp4">
    <source src="videos/videobackgroundteacher.mp4" type="video/mp4">
  </video>
  <div class="bg-shade"></div>
  <div class="bg-glow"></div>
</div>
<section class="view" id="view-pin">
  <div class="pin-card">
    <div class="pin-logo"><img src="images/eplus-logo.png" alt="E-PLUS" draggable="false"></div>
    <div class="pin-brand-en">E-PLUS EDUCATION CENTER</div>
    <div class="pin-brand-ar">مركز التعليم والدعم المدرسي</div>
    <div class="pin-lock">🔐</div>
    <div class="pin-title">الدخول إلى نظام تسجيل الحضور</div>
    <div class="pin-sub">أدخل رمز PIN الخاص بالنظام</div>
    <input type="password" id="pin-input" class="pin-input" inputmode="numeric" autocomplete="off" maxlength="12" placeholder="••••">
    <button type="button" class="pin-btn" id="pin-btn">دخول</button>
    <div class="pin-error" id="pin-error">رمز PIN غير صحيح</div>
    <div class="pin-foot">E-PLUS Education Center — نظام تسجيل حضور الطلاب</div>
  </div>
</section>
<div id="app" class="locked">
  <header class="topbar">
    <div class="brand">
      <img class="logo" src="images/education-plus-center-logo.png" alt="Education Plus Center" draggable="false">
      <div class="title">
        <div class="en">E-PLUS <span class="live-badge"><span class="dot"></span>نظام الحضور</span></div>
        <div class="ar" id="header-sub">نقطة تسجيل حضور الطلاب — الاستقبال</div>
      </div>
    </div>
    <div class="top-actions">
      <div class="clock">
        <div class="time" id="clock-time">--:--:--</div>
        <div class="date" id="clock-date"></div>
      </div>
      <button type="button" class="lock-btn" id="lock-btn">🔒 قفل</button>
    </div>
  </header>
  <main>
    <section class="view view-screen active" id="view-kiosk">
      <div class="kiosk-layout">
        <div class="kiosk-sidebar">
          <div class="k-counter">
            <div class="k-counter-label">الحضور اليوم</div>
            <div class="k-counter-num"><span id="k-attended">0</span></div>
          </div>
        </div>
        <div class="kiosk-main">
          <div class="scan-stage">
            <div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div>
            <div class="scan-card" id="scan-card">
              <div class="scanline"></div>
              <div class="bars" id="scan-bars"></div>
              <div class="code-num" id="scan-code">•••••••••••••</div>
              <div class="chip">SP-1160</div>
            </div>
          </div>
          <div id="kiosk-ready-msg">
            <div class="k-ready-text">مرر بطاقة الطالب أمام جهاز الماسح</div>
            <div class="k-ready-sub">التسجيل تلقائي — لا حاجة للضغط على أي زر</div>
          </div>
          <div class="k-status-pill" id="k-status-pill"><span class="dot"></span>الماسح جاهز — امسح البطاقة</div>
          <div class="k-last-read" id="k-last-read"></div>
          <button class="manual-toggle" id="manual-toggle" type="button">⌨️ إدخال يدوي</button>
          <div class="manual-row" id="manual-row">
            <input type="text" id="manual-input" autocomplete="off" placeholder="رقم الطالب أو الباركود">
            <button type="button" id="manual-submit">تسجيل</button>
          </div>
          <button class="debug-toggle" id="debug-toggle" type="button">🔧 Debug</button>
          <div class="debug-panel" id="debug-panel">
            <h4>SCANNER DEBUG — SP-1160</h4>
            <div class="debug-grid">
              <div class="d"><span class="k">Raw Input</span><span class="v" id="db-buffer">—</span></div>
              <div class="d"><span class="k">event.key</span><span class="v" id="db-key">—</span></div>
              <div class="d"><span class="k">event.code</span><span class="v" id="db-code">—</span></div>
              <div class="d"><span class="k">keyCode</span><span class="v" id="db-keycode">—</span></div>
              <div class="d"><span class="k">Length</span><span class="v" id="db-len">0</span></div>
              <div class="d"><span class="k">Timing</span><span class="v" id="db-timing">—</span></div>
              <div class="d"><span class="k">Enter</span><span class="v" id="db-enter">—</span></div>
              <div class="d"><span class="k">Layout</span><span class="v" id="db-layout">—</span></div>
            </div>
            <div class="debug-log" id="db-log"></div>
          </div>
        </div>
      </div>
    </section>
    <div id="view-teachers" class="view-teachers"></div>
  </main>
</div>
<div class="scan-overlay" id="scan-overlay">
  <div class="so-inner">
    <div class="so-icon" id="so-icon"></div>
    <div class="so-title" id="so-title"></div>
    <div class="so-name" id="so-name"></div>
    <div class="so-sub" id="so-sub"></div>
  </div>
</div>
<audio id="snd-correct" src="sounds/correct.mp3" preload="auto"></audio>
<audio id="snd-incorrect" src="sounds/incorrect.mp3" preload="auto"></audio>
<script>
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  SubscriptionService.init(SUPABASE_URL, SUPABASE_KEY);
  var ALGERIA_TZ = 'Africa/Algiers';
  var PIN_SESSION_KEY = 'eplus_att_pin';
  var PIN_HASH = '023e33504ab909cf87a6f4e4e545090e40bdc0a2153e5b68b19f7fad2b737904';
  var PIN_FALLBACK = String.fromCharCode(50, 48, 49, 57);
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function studentFullName(s) { return ((s && (s.first_name || '') + ' ' + (s.last_name || '')) || '').trim(); }
  var ICONS_SVG = {
    student: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='#6366f1' d='M12 3L1 9l11 6 9-4.91V17h2V9L12 3z'/><path fill='#6366f1' d='M5 13.18V17c0 1.66 3.13 3 7 3s7-1.34 7-3v-3.82l-7 3.82-7-3.82z'/></svg>",
    teacher: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='8' r='4' fill='#059669'/><path d='M4 21c0-4 3.58-6.5 8-6.5s8 2.5 8 6.5' fill='#059669'/></svg>",
    admin: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2l8 3v6c0 5.25-3.4 9.6-8 11-4.6-1.4-8-5.75-8-11V5l8-3z' fill='#b45309'/><circle cx='12' cy='10' r='2.6' fill='#fff'/><path d='M9.3 15h5.4v1.6a2.7 2.7 0 0 1-5.4 0V15z' fill='#fff'/></svg>"
  };
  function svgIcon(k) { return 'data:image/svg+xml;utf8,' + encodeURIComponent(ICONS_SVG[k] || ICONS_SVG.student); }
  window.__svgIcon = svgIcon;

  var appUnlocked = false, processing = false, authState = { signedIn: false, reason: '' };
  var layoutInfo = '—', dbOpen = false;
  var attendedCount = 0;
  if (!fbReady) console.error('[ATTENDANCE] Firebase init failed');

  function tick() {
    var now = new Date();
    $('clock-time').textContent = new Intl.DateTimeFormat('ar-DZ', { timeZone: ALGERIA_TZ, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(now);
    $('clock-date').textContent = new Intl.DateTimeFormat('ar-DZ', { timeZone: ALGERIA_TZ, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(now);
  }
  tick(); setInterval(tick, 1000);
  function fmtTime(d) { return new Intl.DateTimeFormat('ar-DZ', { timeZone: ALGERIA_TZ, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(d || new Date()); }
  function fmtDate(d) { return new Intl.DateTimeFormat('ar-DZ', { timeZone: ALGERIA_TZ, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d || new Date()); }

  (function buildBars() {
    var w = [3,1,2,1,1,3,1,2,1,1,3,2,1,1,2,3,1,1,1,2,1,3,2,1,1,1,2,3];
    var h = [34,50,42,50,50,34,50,42,50,50,34,42,50,50,42,34,50,50,50,42,50,34,42,50,50,50,42,34];
    var b = ''; for (var i = 0; i < w.length; i++) b += '<i style="width:'+w[i]+'px;height:'+h[i]+'px"></i>';
    $('scan-bars').innerHTML = b;
  })();

  // ── PIN gate ──
  function isUnlocked() { try { return sessionStorage.getItem(PIN_SESSION_KEY) === '1'; } catch (e) { return false; } }
  function setUnlocked(v) { try { if (v) sessionStorage.setItem(PIN_SESSION_KEY, '1'); else sessionStorage.removeItem(PIN_SESSION_KEY); } catch (e) {} }
  function checkPin(pin) {
    try {
      if (typeof crypto !== 'undefined' && crypto.subtle && typeof TextEncoder !== 'undefined') {
        return crypto.subtle.digest('SHA-256', new TextEncoder().encode(String(pin))).then(function (buf) {
          var h = '', a = new Uint8Array(buf);
          for (var i = 0; i < a.length; i++) h += (a[i] < 16 ? '0' : '') + a[i].toString(16);
          return h === PIN_HASH;
        });
      }
    } catch (e) {}
    return Promise.resolve(String(pin) === PIN_FALLBACK);
  }
  function showPinError() { var el = $('pin-error'); if (el) { el.classList.remove('show'); void el.offsetWidth; el.classList.add('show'); } }
  function clearPinError() { var el = $('pin-error'); if (el) el.classList.remove('show'); }
  function showPin() {
    setUnlocked(false); appUnlocked = false;
    $('view-pin').classList.add('active'); $('app').classList.add('locked');
    try { $('pin-input').focus(); } catch (e) {}
  }
  function showApp() { appUnlocked = true; $('view-pin').classList.remove('active'); $('app').classList.remove('locked'); renderReady(); }
  function unlockApp(pin) {
    return checkPin(pin).then(function (ok) {
      if (ok) { clearPinError(); showApp(); logScanner('PIN OK'); ensureAttendanceAuth(); }
      else { showPinError(); logScanner('PIN rejected'); }
      return ok;
    });
  }
  function lockApp() { showPin(); logScanner('System locked'); }
  function submitPin() { var v = $('pin-input').value; unlockApp(v).then(function (ok) { if (ok) $('pin-input').value = ''; }); }
  $('pin-btn').addEventListener('click', submitPin);
  $('pin-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); submitPin(); } });
  $('lock-btn').addEventListener('click', lockApp);
  window.__attUnlock = unlockApp; window.__attLock = lockApp;

  // ── Firebase anonymous auth ──
  function ensureAttendanceAuth() {
    return new Promise(function (resolve) {
      if (authState.signedIn) { resolve(authState); return; }
      try {
        if (typeof firebase === 'undefined' || !firebase.auth || typeof firebase.auth !== 'function') { authState.reason = 'firebase-auth SDK missing'; resolve(authState); return; }
        firebase.app('kiosk').auth().signInAnonymously().then(function () { authState.signedIn = true; authState.reason = ''; console.log('[ATTENDANCE AUTH] signed in'); resolve(authState); })
        .catch(function (e) { authState.reason = (e && e.code) || 'unknown'; console.warn('[ATTENDANCE AUTH] failed:', authState.reason); resolve(authState); });
      } catch (e) { authState.reason = (e && e.message) || 'unknown'; resolve(authState); }
    });
  }

  function switchView(n) { var vs = document.querySelectorAll('.view'); for (var i = 0; i < vs.length; i++) vs[i].classList.remove('active'); var v = $('view-' + n); if (v) v.classList.add('active'); }
  function updateCounter() {
    $('k-attended').textContent = attendedCount;
  }
  // ── Scanner debug ──
  function logScanner(text) {
    var log = $('db-log'); if (!log) return;
    var line = document.createElement('div');
    line.textContent = new Date().toLocaleTimeString('ar-DZ') + ' | ' + text;
    log.insertBefore(line, log.firstChild);
    while (log.children.length > 60) log.removeChild(log.lastChild);
  }
  function updateDebug(payload) {
    if (!dbOpen) return;
    var i = payload.input || '—', k = payload.key || '—', c = payload.code || '—', kc = payload.keyCode || '—', l = payload.len || 0, t = payload.timing || '—', en = payload.enter ? 'YES' : 'NO', ly = payload.layout || '—';
    $('db-buffer').textContent = i; $('db-key').textContent = k; $('db-code').textContent = c; $('db-keycode').textContent = kc; $('db-len').textContent = l; $('db-timing').textContent = t; $('db-enter').textContent = en; $('db-layout').textContent = ly;
    if (payload.enter) { $('db-enter').classList.add('good'); setTimeout(function () { if ($('db-enter')) $('db-enter').classList.remove('good'); }, 1500); }
    if (payload.layout) { layoutInfo = payload.layout; }
  }
  function resetDebug() { $('db-buffer').textContent = '—'; $('db-key').textContent = '—'; $('db-code').textContent = '—'; $('db-keycode').textContent = '—'; $('db-len').textContent = '0'; $('db-timing').textContent = '—'; $('db-enter').textContent = '—'; }
  $('debug-toggle').addEventListener('click', function () {
    dbOpen = !dbOpen; $('debug-panel').classList.toggle('show', dbOpen);
    logScanner('Debug ' + (dbOpen ? 'opened' : 'closed'));
  });

  // ── Sound + vibration ──
  var audioCtx = null;
  function getAudioCtx() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); return audioCtx; }
  function playTone(freq, durationMs) {
    try {
      var ctx = getAudioCtx(), osc = ctx.createOscillator(), gain = ctx.createGain();
      osc.type = 'sine'; osc.frequency.value = freq;
      gain.gain.value = 0.15;
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(); osc.stop(ctx.currentTime + durationMs / 1000);
    } catch (e) {}
  }
  function vibrate(ms) { try { if (navigator.vibrate) navigator.vibrate(ms); } catch (e) {} }
  function playSoundCorrect() {
    try { var a = $('snd-correct'); a.currentTime = 0; a.play(); } catch (e) {}
    vibrate(100);
  }
  function playSoundIncorrect() {
    try { var a = $('snd-incorrect'); a.currentTime = 0; a.play(); } catch (e) {}
    vibrate([100, 50, 100, 50, 100]);
  }

  // ── Scan overlay (auto-dismiss) ──
  var overlayTimer = null;
  function showScanOverlay(color, icon, title, name, sub, dismissMs) {
    if (overlayTimer) clearTimeout(overlayTimer);
    var el = $('scan-overlay');
    el.className = 'scan-overlay show ' + color;
    $('so-icon').textContent = icon;
    $('so-title').textContent = title;
    $('so-name').textContent = name || '';
    $('so-sub').textContent = sub || '';
    overlayTimer = setTimeout(function () { el.className = 'scan-overlay'; }, dismissMs || 2500);
  }

  // ── Grace tracking (Firestore) ──
  async function hasGraceUsed(studentId) {
    if (!fbReady) return false;
    var ym = AttendanceService.today().slice(0, 7);
    var docId = 'grace_' + studentId + '_' + ym;
    try {
      var doc = await window.db.collection('support_attendance').doc(docId).get();
      return doc.exists;
    } catch (e) { return false; }
  }
  async function writeGraceRecord(studentId, studentName) {
    if (!fbReady) return;
    var ym = AttendanceService.today().slice(0, 7);
    var docId = 'grace_' + studentId + '_' + ym;
    try {
      await window.db.collection('support_attendance').doc(docId).set({
        studentId: studentId,
        studentName: studentName || '',
        type: 'grace',
        yearMonth: ym,
        date: AttendanceService.today(),
        createdAt: new Date().toISOString()
      });
    } catch (e) { console.warn('[GRACE WRITE]', e); }
  }

  function renderReady() {
    $('k-status-pill').innerHTML = '<span class="dot"></span>الماسح جاهز — امسح البطاقة';
    $('k-last-read').textContent = '';
    scanner.start();
    grabScanFocus();
  }
  // ── Scan handler ──
  async function handleScan(val) {
    if (processing) return;
    processing = true;
    scanner.setBusy(true);
    $('k-status-pill').innerHTML = '<span class="dot" style="background:#f59e0b"></span>جاري التحقق...';
    var raw = String(val || '').trim();

    // 1. Resolve student ID from barcode
    var scanResult = null;
    try { scanResult = await AttendanceService.resolveStudentFromScan(raw); } catch (e) { logScanner('resolveStudentFromScan error: ' + e.message); }
    var studentId = scanResult && scanResult.student ? scanResult.student.id : null;
    if (!studentId) {
      $('k-last-read').textContent = raw;
      $('k-status-pill').innerHTML = '<span class="dot" style="background:#ef4444"></span>بطاقة غير معروفة';
      logScanner('REJECT unknown card: ' + raw);
      showScanOverlay('red', '❌', 'بطاقة غير معروفة', raw, 'لا يوجد طالب مرتبط بهذه البطاقة', 2500);
      playSoundIncorrect();
      processing = false; scanner.setBusy(false);
      setTimeout(renderReady, 1800);
      return;
    }
    logScanner('resolveStudent: id=' + studentId + ' raw=' + raw);

    // 2. Fetch registration
    var reg = null;
    try { reg = await RegistrationService.getById(studentId); } catch (e) { logScanner('getById error: ' + e.message); }
    if (!reg) {
      $('k-last-read').textContent = studentId;
      $('k-status-pill').innerHTML = '<span class="dot" style="background:#ef4444"></span>طالب غير موجود';
      logScanner('REJECT student not found: ' + studentId);
      showScanOverlay('red', '❌', 'طالب غير موجود', studentId, 'لم يتم العثور على بيانات الطالب', 2500);
      playSoundIncorrect();
      processing = false; scanner.setBusy(false);
      setTimeout(renderReady, 1800);
      return;
    }
    var name = studentFullName(reg);
    $('k-last-read').textContent = studentId + ' — ' + name;
    logScanner('student: ' + name + ' (id=' + studentId + ', status=' + reg.status + ')');

    // 3. Check registration status
    if (reg.status !== 'مسجل نهائياً') {
      $('k-status-pill').innerHTML = '<span class="dot" style="background:#f59e0b"></span>حالة غير مقبولة — ' + name;
      logScanner('REJECT status: ' + reg.status);
      showScanOverlay('red', '⚠️', 'الحالة: ' + reg.status, name, 'الطالب غير مسجل نهائياً', 3000);
      playSoundIncorrect();
      processing = false; scanner.setBusy(false);
      setTimeout(renderReady, 2000);
      return;
    }

    // 4. Show teacher selection
    showTeacherSelection(reg, raw, studentId, name);
  }

  var pendingReg = null, pendingBarcode = null, pendingStudentId = null, pendingName = null;
  function showTeacherSelection(reg, barcode, studentId, name) {
    scanner.stop();
    pendingReg = reg; pendingBarcode = barcode; pendingStudentId = studentId; pendingName = name;
    var subjects = reg.subjects || [];
    if (!subjects.length) {
      showScanOverlay('red', '📚', 'لا مواد مسجلة', name, 'لا توجد مواد مسجلة لهذا الطالب', 2200);
      processing = false; scanner.setBusy(false);
      setTimeout(renderReady, 1600);
      return;
    }
    var uniqueMap = {}, teachers = [];
    subjects.forEach(function (s) {
      var key = s.teacher || '';
      if (!uniqueMap[key]) { uniqueMap[key] = { teacher: s.teacher, subject: s.subject }; teachers.push(uniqueMap[key]); }
    });
    var colors = ['t1','t2','t3','t4','t5','t6','t7','t8'];
    var icons = ['📚','📖','✏️','🔬','🧮','📐','🎨','🌍'];
    var html = '<button class="ts-back" id="ts-back-btn">✕ رجوع</button>';
    html += '<div class="ts-header">';
    html += '<div class="ts-student-name">🎓 ' + esc(name) + '</div>';
    html += '<div class="ts-student-id">#' + studentId + '</div>';
    html += '<div class="ts-subtitle">اختر الأستاذ لتسجيل الحضور</div>';
    html += '</div>';
    html += '<div class="ts-grid">';
    teachers.forEach(function (t, i) {
      html += '<div class="ts-card ' + colors[i % colors.length] + '" data-teacher="' + esc(t.teacher) + '" data-subject="' + esc(t.subject) + '">';
      html += '<div class="tc-icon">' + icons[i % icons.length] + '</div>';
      html += '<div class="tc-name">' + esc(t.teacher) + '</div>';
      html += '<div class="tc-subject">' + esc(t.subject) + '</div>';
      html += '</div>';
    });
    html += '</div>';
    var container = $('view-teachers');
    container.innerHTML = html;
    $('view-kiosk').classList.remove('active');
    container.classList.add('active');
    document.querySelectorAll('.ts-card').forEach(function (card) {
      card.addEventListener('click', function () {
        var teacherName = card.getAttribute('data-teacher');
        var subjectName = card.getAttribute('data-subject');
        hideTeacherSelection();
        selectTeacher(teacherName, subjectName);
      });
    });
    $('ts-back-btn').addEventListener('click', function () {
      hideTeacherSelection();
      processing = false; scanner.setBusy(false);
      renderReady();
    });
  }
  function hideTeacherSelection() {
    $('view-teachers').classList.remove('active');
    $('view-kiosk').classList.add('active');
  }
  async function selectTeacher(teacherName, subjectName) {
    $('k-status-pill').innerHTML = '<span class="dot" style="background:#f59e0b"></span>جاري التحقق — ' + pendingName;
    logScanner('teacher select: ' + teacherName + ' / ' + subjectName);

    // Subscription check per teacher+subject
    var subCheck = null;
    try { subCheck = await SubscriptionService.getActiveSubscriptionForSubject(pendingStudentId, subjectName, teacherName, AttendanceService.today()); } catch (e) { logScanner('subCheck error: ' + e.message); }

    if (subCheck && subCheck.status === 'active') {
      logScanner('GREEN: active subscription for ' + teacherName);
      if (fbReady && authState.signedIn) {
        try {
          await AttendanceService.writeMirror({
            studentId: pendingStudentId, studentName: pendingName, studentType: pendingReg.student_type || '',
            sessionNumber: 1, date: AttendanceService.today(), checkInTime: AttendanceService.nowTime(),
            barcodeValue: pendingBarcode, source: 'eplus-attendance', teacherName: teacherName, subjectName: subjectName,
            createdAt: AttendanceService.nowTime()
          });
          logScanner('mirror write OK');
        } catch (e) { logScanner('mirror write error: ' + e.message); }
      }
      $('k-status-pill').innerHTML = '<span class="dot" style="background:#22c55e"></span>تم التسجيل — ' + pendingName;
      showScanOverlay('green', '✅', 'تم تسجيل الحضور', pendingName, teacherName + ' — ' + subjectName, 2200);
      playSoundCorrect();
      attendedCount++; updateCounter();
      processing = false; scanner.setBusy(false);
      setTimeout(renderReady, 1600);
      return;
    }

    // No active subscription — check grace per teacher
    var graceKey = pendingStudentId + '_' + teacherName + '_' + subjectName;
    var graceUsed = false;
    try {
      var ym = AttendanceService.today().slice(0, 7);
      var gDoc = await window.db.collection('support_attendance').doc('grace_' + graceKey + '_' + ym).get();
      graceUsed = gDoc.exists;
    } catch (e) { logScanner('grace check error: ' + e.message); }

    if (!graceUsed) {
      logScanner('ORANGE: grace for ' + teacherName);
      if (fbReady && authState.signedIn) {
        try {
          await AttendanceService.writeMirror({
            studentId: pendingStudentId, studentName: pendingName, studentType: pendingReg.student_type || '',
            sessionNumber: 1, date: AttendanceService.today(), checkInTime: AttendanceService.nowTime(),
            barcodeValue: pendingBarcode, source: 'eplus-attendance', type: 'grace_session',
            teacherName: teacherName, subjectName: subjectName,
            createdAt: AttendanceService.nowTime()
          });
          await window.db.collection('support_attendance').doc('grace_' + graceKey + '_' + ym).set({
            studentId: pendingStudentId, teacherName: teacherName, subjectName: subjectName,
            type: 'grace', yearMonth: ym, date: AttendanceService.today(), createdAt: new Date().toISOString()
          });
          logScanner('grace record + mirror write OK');
        } catch (e) { logScanner('grace write error: ' + e.message); }
      }
      $('k-status-pill').innerHTML = '<span class="dot" style="background:#f59e0b"></span>تم السماح — ' + pendingName;
      showScanOverlay('orange', '⚠️', 'تم السماح بحضور هذه الحصة', pendingName, teacherName + ' — ' + subjectName + '<br>الاشتراك غير مجدد — يرجى التجديد', 3000);
      playSoundCorrect();
      attendedCount++; updateCounter();
      processing = false; scanner.setBusy(false);
      setTimeout(renderReady, 2200);
      return;
    }

    // RED — grace used
    logScanner('RED: no subscription, grace used for ' + teacherName);
    $('k-status-pill').innerHTML = '<span class="dot" style="background:#ef4444"></span>ممنوع — ' + pendingName;
    showScanOverlay('red', '🚫', 'لا يمكن تسجيل الحضور', pendingName, teacherName + ' — ' + subjectName + '<br>انتهى الاشتراك — تم استخدام الحصة المسموح بها', 3500);
    playSoundIncorrect();
    processing = false; scanner.setBusy(false);
    setTimeout(renderReady, 2500);
  }

  // ── Scanner ──
  var scanner = null;
  try {
    scanner = new BarcodeScanner.Scanner({
      logPrefix: 'ATTENDANCE',
      shouldIgnoreKey: function () { return processing || !appUnlocked; },
      onState: function (info) { if (info && info.buffer !== undefined) { updateDebug(info); if (info.buffer) logScanner('buf=' + info.buffer); } },
      onScan: function (code) {
        logScanner('SCAN: ' + code + ' (len=' + code.length + ')');
        $('k-last-read').textContent = code;
        handleScan(code);
      },
      onInvalid: function (info) { logScanner('INVALID: ' + (info && info.reason || 'unknown')); }
    });
  } catch (e) { console.error('[SCANNER INIT]', e); }

  // ── Manual entry ──
  var manualOpen = false;
  $('manual-toggle').addEventListener('click', function () {
    manualOpen = !manualOpen;
    $('manual-row').classList.toggle('show', manualOpen);
    if (manualOpen) $('manual-input').focus();
  });
  async function submitManual() {
    var v = $('manual-input').value.trim();
    if (!v || !session) return;
    logScanner('MANUAL: ' + v);
    await handleScan(v);
    $('manual-input').value = '';
  }
  $('manual-submit').addEventListener('click', submitManual);
  $('manual-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); submitManual(); } });

  // ── Focus management (SP-1160) ──
  var focusInterval = null;
  function grabScanFocus() {
    if (focusInterval) clearInterval(focusInterval);
    focusInterval = setInterval(function () {
      if (!appUnlocked || processing) return;
      var act = document.activeElement;
      if (act && (act.tagName === 'INPUT' || act.tagName === 'SELECT' || act.tagName === 'TEXTAREA')) return;
      try { window.focus(); } catch (e) {}
    }, 800);
  }

  // ── Init ──
  (function init() {
    if (isUnlocked()) {
      showApp();
    } else {
      showPin();
    }
    if (fbReady) {
      ensureAttendanceAuth();
    }
  })();

})();
</script>
</body>
</html>

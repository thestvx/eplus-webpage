{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "rewrites": [
      { "source": "/s/**", "destination": "/student.html" }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/dist/**",
      "**/.backup_untracked/**",
      "**/functions/**",
      "**/email-worker/**",
      "**/summerplusgallery/**",
      "*.md",
      "opencode.json",
      "supabase-schema.sql",
      "check_braces.js",
      "main.js",
      "package.json",
      "package-lock.json",
      "firestore.rules"
    ]
  }
}

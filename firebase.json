{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "rewrites": [
      { "source": "/s/**", "destination": "/student.html" }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/dist/**",
      "*.md",
      "opencode.json",
      "supabase-schema.sql"
    ]
  }
}

{
  "name": "eplus-academy",
  "version": "1.0.0",
  "description": "E-Plus Academy Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.eplus.academy",
    "productName": "E-Plus Academy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist",
      "!.git"
    ],
    "win": {
      "target": "nsis",
      "icon": "images/eplus-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "E-Plus Academy"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "firebase-tools": "^15.29.0"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0"
  }
}
